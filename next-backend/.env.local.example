# Copy this file to next-backend/.env.local and set values for your own MongoDB server.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=petcare
CORS_ORIGIN=http://localhost:5173
# Generate a private random value with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-private-random-string-at-least-32-characters-long
# The account with this email receives the admin role after its next sign-in.
ADMIN_EMAIL=admin@example.com
